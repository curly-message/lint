{
  // The shipped declarations compiled as a consumer compiles them: reached
  // through the package's own `exports`, with every declaration file checked.
  // Node's types load because the source they are compared with reads a path
  // through `node:path`.
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2023"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "files": ["./surface.ts"]
}
