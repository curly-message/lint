{
  "name": "@curly-message/eslint-plugin",
  "version": "1.0.0-next.0",
  "description": "ESLint plugin for the Curly Message Format: lints messages in JavaScript, TypeScript and JSON.",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:dist": "tsc -p tests/types/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "pretest": "npm run build && npm run typecheck && npm run typecheck:dist && npm run lint",
    "test": "vitest run && vitest run --mode dist",
    "test:bun": "npm run build && bun --bun vitest run && bun --bun vitest run --mode dist",
    "test:deno": "npm run build && deno run -A npm:vitest run && deno run -A npm:vitest run --mode dist",
    "bench": "npm run build --prefix .. && node ../bench/harness.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/curly-message/lint.git",
    "directory": "eslint-plugin"
  },
  "keywords": [
    "curly-message",
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "i18n",
    "translations"
  ],
  "author": "Jarda Svoboda",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/curly-message/spec/issues"
  },
  "homepage": "https://curlymessage.dev/",
  "dependencies": {
    "@curly-message/lint": "1.0.0-next.0"
  },
  "peerDependencies": {
    "@curly-message/parser": "^3.1.2",
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "@curly-message/parser": "^3.1.2",
    "@eslint/json": "^2.1.0"
  }
}
