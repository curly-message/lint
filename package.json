{
  "name": "@curly-message/lint-workspace",
  "private": true,
  "description": "Workspace root of the Curly Message Format linter: the library and CLI in lint/, the ESLint plugin in eslint-plugin/.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "lint",
    "eslint-plugin"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint --fix .",
    "test": "npm test --workspaces",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.8.1",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.11.0",
    "simple-git-hooks": "^2.13.1",
    "tsup": "^8.0.1",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
