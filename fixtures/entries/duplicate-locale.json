{
  "$schema": "../schema.json",
  "kind": "entries",
  "description": "A locale written two ways.",
  "cases": [
    {
      "name": "a locale written with `_` and with `-`",
      "entries": [
        {
          "locale": "en_US",
          "id": "hi",
          "message": "Hi"
        },
        {
          "locale": "en-US",
          "id": "bye",
          "message": "Bye"
        },
        {
          "locale": "cs",
          "id": "hi",
          "message": "Ahoj"
        },
        {
          "locale": "cs",
          "id": "bye",
          "message": "Nashle"
        }
      ],
      "options": {
        "source": "cs",
        "locales": ["en_US", "en-US", "cs"]
      },
      "findings": [
        {
          "entry": 1,
          "code": "duplicate-locale",
          "severity": "warning",
          "message": "`en-US` is `en_US` written another way, so a host that looks a locale up as written reads only the messages under the one it is asked for.",
          "start": 0,
          "end": 0
        }
      ]
    },
    {
      "name": "a locale written in two cases",
      "entries": [
        {
          "locale": "en-us",
          "id": "hi",
          "message": "Hi"
        },
        {
          "locale": "en-US",
          "id": "bye",
          "message": "Bye"
        },
        {
          "locale": "cs",
          "id": "hi",
          "message": "Ahoj"
        },
        {
          "locale": "cs",
          "id": "bye",
          "message": "Nashle"
        }
      ],
      "options": {
        "source": "cs",
        "locales": ["en-us", "en-US", "cs"]
      },
      "findings": [
        {
          "entry": 1,
          "code": "duplicate-locale",
          "severity": "warning",
          "message": "`en-US` is `en-us` written another way, so a host that looks a locale up as written reads only the messages under the one it is asked for.",
          "start": 0,
          "end": 0
        }
      ]
    },
    {
      "name": "one set of messages under two spellings, which defines no id twice",
      "entries": [
        {
          "locale": "en-US",
          "id": "hi",
          "message": "Hi"
        },
        {
          "locale": "en-US",
          "id": "bye",
          "message": "Bye"
        },
