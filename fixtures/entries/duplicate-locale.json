          "locale": "cs",
          "id": "bye",
          "message": "Nashle"
        }
      ],
      "options": {
        "locales": ["en-US", "en_US", "cs"]
      },
      "findings": [
        {
          "entry": 2,
          "code": "duplicate-locale",
