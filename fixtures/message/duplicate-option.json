{
  "$schema": "../schema.json",
  "kind": "message",
  "description": "An option an earlier one selects in place of (sections 9.3, 11.1 and 11.5).",
  "cases": [
    {
      "name": "keys `eq` compares alike",
      "message": "{{v; a:1; A:2;}}",
      "findings": [
        {
          "code": "duplicate-option",
          "severity": "warning",
          "section": "11.1",
          "message": "`A` selects where `a` before it does, so this option is never selected.",
          "start": 10,
          "end": 11
        }
      ]
    },
    {
      "name": "keys `ne` compares alike",
      "message": "{{v:ne; x:1; X:2;}}",
      "findings": [
        {
          "code": "duplicate-option",
          "severity": "warning",
          "section": "11.1",
          "message": "`X` selects where `x` before it does, so this option is never selected.",
          "start": 13,
          "end": 14
        }
      ]
    },
    {
      "name": "keys `lt` compares alike",
      "message": "{{v:lt; 2:a; 2.0:b;}}",
      "findings": [
        {
          "code": "duplicate-option",
          "severity": "warning",
          "section": "11.1",
          "message": "`2.0` selects where `2` before it does, so this option is never selected.",
          "start": 13,
          "end": 16
        }
      ]
    },
    {
      "name": "keys `plural` selects alike",
      "message": "{{n:plural; one:a; 2:b; 2.0:c; one:d; other:e;}}",
