        {
          "code": "duplicate-option",
          "severity": "warning",
          "section": "11.5",
          "message": "`2.0` selects where `2` before it does, so this option is never selected.",
          "start": 24,
          "end": 27
        },
        {
          "code": "duplicate-option",
          "severity": "warning",
          "section": "11.5",
          "message": "`one` selects where `one` before it does, so this option is never selected.",
          "start": 31,
