{
  "$schema": "../schema.json",
  "kind": "message",
  "description": "Which plural rules a message is read with: none without a locale or for one the host has no rules for, and a locale written with `_`.",
  "cases": [
    {
      "name": "no locale",
      "message": "{{n:plural; one:a; other:b;}}",
      "findings": []
    },
    {
      "name": "a locale the host has no rules for",
      "message": "{{n:plural; one:a; other:b;}}",
      "options": {
        "locale": "xx"
      },
      "findings": []
    },
    {
      "name": "text that is no locale",
      "message": "{{n:plural; one:a; other:b;}}",
      "options": {
        "locale": "not a locale"
      },
      "findings": []
    },
    {
      "name": "a locale written with `_`, read as one written with `-`",
      "message": "{{n:plural; one:a; other:b;}}",
      "options": {
        "locale": "cs_CZ"
      },
      "plurals": {
        "cs-cz": {
          "cardinal": {
            "categories": ["few", "many", "one", "other"],
            "select": {
              "one": [1, -1, 1.001, -1.001],
              "few": [2, 3, 4, -2, -3, -4, 2.001, 3.001, 4.001, -2.001, -3.001, -4.001],
              "many": [0.5, 1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, 8.5, 9.5, 10.5, 11.5, 12.5, 13.5, 14.5, 15.5, 16.5, 17.5, 18.5, 19.5, 20.5, -0.5, -1.5, -2.5, -3.5, -4.5, -5.5, -6.5, -7.5, -8.5, -9.5, -10.5, -11.5, -12.5, -13.5, -14.5, -15.5, -16.5, -17.5, -18.5, -19.5, -20.5]
            }
          }
        }
      },
      "findings": [
        {
          "code": "missing-category",
          "severity": "error",
          "section": "11.5",
          "message": "`cs_CZ` puts 0.5, 1.5 and 2.5 in `many`, and this selection has no `many` option, so those take the fallback chain.",
          "start": 4,
          "end": 10
        },
        {
          "code": "missing-category",
          "severity": "error",
          "section": "11.5",
          "message": "`cs_CZ` puts 2, 3 and 4 in `few`, and this selection has no `few` option, so those take the fallback chain.",
          "start": 4,
          "end": 10
        }
      ]
    }
  ]
