{
  // The shipped declarations compiled as a consumer compiles them: reached
  // through the package's own `exports`, with every declaration file checked.
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2023"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": []
  },
  "files": ["./surface.ts"]
}
