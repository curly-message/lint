{
  // The shipped declarations compiled as a consumer compiles them: reached
  // through the package's own `exports`, with every declaration file checked.
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2023"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    // The source the declarations are held to reads the core's bytes and
    // the runtime's globals.
    "types": ["node"]
  },
  "files": ["./surface.ts", "../../src/wasm.d.ts"]
}
